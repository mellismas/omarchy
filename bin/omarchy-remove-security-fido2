#!/bin/bash

# omarchy:summary=Remove FIDO2 authentication from sudo and polkit
# omarchy:requires-sudo=true

set -e

source "$OMARCHY_PATH/install/helpers/pam-stack.sh"


# Every active FIDO2 line goes, in one step per stack, and sudo's face line
# goes back to plain `sufficient` with no FIDO2 line left for it to jump
# over (install/helpers/pam-stack.sh).
remove_u2f_lines() {
  local file=$1 name=$2
  pam_stack_needed "$file" unfido2 "" || return 0
  echo "Removing FIDO2 authentication from $name..."
  if ! pam_stack_place "$file" unfido2 ""; then
    echo -e "\e[31mThe $name configuration could not be changed as intended and was left as it was.\e[0m"
    return 1
  fi
}

remove_pam_config() {
  # Remove from sudo
  remove_u2f_lines /etc/pam.d/sudo sudo

  # Remove from polkit
  if [[ -f /etc/pam.d/polkit-1 ]]; then
    remove_u2f_lines /etc/pam.d/polkit-1 polkit
  fi

  # Remove from the lock screen: its key lane shows only while this exists
  if [[ -e $lock_pam || -L $lock_pam ]]; then
    echo "Removing FIDO2 authentication from the lock screen..."
    if ! pam_stack_remove "$lock_pam"; then
      echo -e "\e[31mThe lock screen's key lane could not be removed.\e[0m"
      return 1
    fi
  fi
}

lock_pam=/etc/pam.d/omarchy-lock-fido2

echo -e "\e[32mRemoving FIDO2 device from authentication.\n\e[0m"

remove_pam_config

authdir=/etc/fido2

# -d follows symlinks, so a dangling link at /etc/fido2 would survive this and
# a later setup would install the authfile through it. rm -rf on a symlink
# removes the link itself, never the directory it points at.
if [[ -e $authdir || -L $authdir ]]; then
  echo "Removing FIDO2 configuration..."
  sudo rm -rf "$authdir"
fi

echo "Removing FIDO2 packages..."
omarchy-pkg-drop libfido2 pam-u2f

echo -e "\e[32mFIDO2 authentication has been completely removed.\e[0m"
