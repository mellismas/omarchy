#!/bin/bash

# omarchy:summary=Set up face authentication for the lock screen, sudo, and polkit
# omarchy:args=[--add [label] | --gestures | --walk-away <on|off> | --away-time <never|20|30|60> | --secure-away-time <20|30|60> | --obscured-face-lock <never|240|120|60|30|10|5|2|1> | --secure-obscured-face-lock <10|5|2|1>]
# omarchy:requires-sudo=true

set -e

source "$OMARCHY_PATH/install/helpers/pam-stack.sh"

# These enroll the invoking user's face. Under sudo, $USER is root, which would
# enroll root and leave the real user's templates behind on removal.
if (( EUID == 0 )); then
  echo "Run omarchy-setup-security-face as your user, not under sudo (it asks for sudo where needed)." >&2
  exit 1
fi
target_user=$USER

usage() {
  echo "Usage: omarchy setup security face [--add [label] | --gestures | --walk-away on|off | --away-time never|20|30|60 | --secure-away-time 20|30|60 | --obscured-face-lock never|240|120|60|30|10|5|2|1 | --secure-obscured-face-lock 10|5|2|1]" >&2
  exit 1
}


# The polkit override setup creates is remembered by a copy of exactly what
# it wrote, kept outside /etc/pam.d because a stray file inside the PAM
# directory is a service of its own. Removal deletes the override only while
# it still matches the copy. The directory is root-only, so the marker is
# looked up through sudo.
marker_dir=/var/backups/faceauth
created_marker=$marker_dir/polkit-1.created-by-faceauth
# The sudo and polkit-1 lines of FaceAuth's pam-example.txt. The module's
# answers on them: a match is PAM_SUCCESS; the user's no at the window (a
# head shake, a dismissed window, a confirm after the nods that failed) is
# PAM_AUTH_ERR, which the daemon sends only for a polkit request; anything
# else, from no daemon to no match, goes on to the key line and the
# password lines below.
#
# sudo: `sufficient`. The daemon answers a no there with `consent_denied`,
# which the module ignores, and the stack goes on to the key line and then
# the terminal's password prompt, where sudo asks anyway.
# polkit: the same line with a different control. Under `sufficient` a no
# would fall through to polkit's password dialog, and polkit would start the
# helper again and ask forever; auth_err=die ends the stack on it instead,
# the agent cancels the request, and polkit reports "Not authorized".
face_line='auth      sufficient pam_faceauth.so socket=/run/faceauth/sock consent'
polkit_face_line='auth      [success=done auth_err=die default=ignore] pam_faceauth.so socket=/run/faceauth/sock consent'

# Elevation is a deliberate act: the line carries `consent`, so the daemon
# opens a window naming the command and the requester, and the request is
# approved by two nods, by the password typed into that window, or by a touch
# of a registered FIDO2 key. Sitting in front of the machine never elevates
# anything by itself.
#
# The line goes above the password and above the key line. While face is
# set up the key line is the face daemon's own key-fallback line, in place
# of our pam_u2f line and with the options it had, so every use of the key
# goes through the daemon: on the card, on this line after a no at the card
# or with no card, and on the lock screen, one at a time, and never for a
# request nobody can see. The face line stays after any fingerprint line,
# which the window cannot ask yet, and after a pam_u2f line setup did not
# write, which stays where it is (the daemon then offers the key nowhere,
# and faceauth doctor says why). Any order of setups ends fingerprint,
# face, the key, then the password (install/helpers/pam-stack.sh).
#
# A face line that is not exactly ours (a hand-edited stack, or one missing
# `consent`) would approve on a plain look with no window at all, so it is
# replaced rather than kept.
write_face_line() {
  local file="$1" line="$2"
  if ! pam_stack_needed "$file" face "$line"; then
    echo "${file##*/} is already configured for face authentication."
    return 0
  fi
  if grep -qxF "$line" "$file" || grep -qxF "${line/sufficient/[success=done authinfo_unavail=1 default=ignore]}" "$file"; then
    echo "Moving the face line in ${file##*/} into place, with the key through face authentication..."
  elif grep -qE '^[^#]*pam_faceauth\.so' "$file"; then
    echo "Replacing a face line in ${file##*/} that setup did not write..."
  else
    echo "Configuring ${file##*/} for face authentication..."
  fi
  if ! pam_stack_place "$file" face "$line"; then
    echo -e "\e[31m${file##*/} could not be changed as intended and was left as it was.\e[0m"
    return 1
  fi
}

setup_pam_config() {
  write_face_line /etc/pam.d/sudo "$face_line"

  if [[ -f /etc/pam.d/polkit-1 ]]; then
    write_face_line /etc/pam.d/polkit-1 "$polkit_face_line"
  else
    # No file in /etc/pam.d means polkit runs the vendor stack; an override
    # there must carry the whole stack, not just our line. The marker keeps a
    # copy of exactly what was written: removal deletes the file, returning
    # polkit to the vendor stack, only while it still matches that copy. A
    # fingerprint or FIDO2 line added later makes the file someone else's too,
    # and then removal strips our line and leaves the rest in place. The
    # file is made under the PAM edit lock, unless one appeared meanwhile,
    # which then gets our line instead.
    echo "Creating polkit configuration with face authentication..."
    local status=0
    pam_stack_locked create_polkit_locked || status=$?
    if (( status == 2 )); then
      echo -e "\e[31mpolkit-1 could not be created as intended.\e[0m"
      return 1
    fi
  fi
}

polkit_stack="#%PAM-1.0
$polkit_face_line
auth       include      system-auth
account    include      system-auth
password   include      system-auth
session    include      system-auth"

create_polkit_locked() {
  if [[ -f /etc/pam.d/polkit-1 ]]; then
    pam_stack_place_locked /etc/pam.d/polkit-1 face "$polkit_face_line"
    return
  fi
  sudo install -dm700 "$marker_dir" &&
    pam_stack_write /etc/pam.d/polkit-1 "$polkit_stack" &&
    sudo cp -p /etc/pam.d/polkit-1 "$created_marker" || return 2
}

# The omarchy-lock-face block of FaceAuth's pam-example.txt. The lock
# screen's face stack is its own PAM service beside the password and
# fingerprint ones, so it takes no prompt: looking at the machine is the act.
# The password is a separate service on its own lane, so this one must be
# closed: an ignore-only stack fails closed on Linux-PAM 1.7.2
# (PAM_PERM_DENIED), but that is library behavior, not a promise, and
# pam_deny makes it explicit.
setup_lock_face_pam() {
  echo "Configuring lock screen for face authentication..."
  if ! pam_stack_locked pam_stack_write "$lock_face_pam" "$lock_face_stack"; then
    echo -e "\e[31mThe lock screen's face service could not be written.\e[0m"
    return 1
  fi
  # With FIDO2 set up too, the lock screen takes the key through this
  # daemon (install/helpers/pam-stack.sh), whichever setup ran first.
  local status=0
  pam_stack_key_lane /etc/pam.d/omarchy-lock-fido2 "$lock_face_pam" /etc/pam.d/sudo /etc/pam.d/polkit-1 || status=$?
  if (( status == 2 )); then
    echo -e "\e[31mThe lock screen's security key lane could not be changed as intended.\e[0m"
    return 1
  fi
  if (( status == 0 )) && [[ -f /etc/pam.d/omarchy-lock-fido2 ]]; then
    echo "Configuring the lock screen to take your security key through face authentication..."
  fi
  return 0
}

lock_face_pam=/etc/pam.d/omarchy-lock-face
lock_face_stack='#%PAM-1.0
auth       sufficient                  pam_faceauth.so socket=/run/faceauth/sock timeout=8
auth       required                    pam_deny.so
account    include                     system-local-login'

# After a successful enrollment setup asks for both obscured face lock times,
# with the shipped ones selected, and saves them with `presence
# obscured-lock`, which never switches the walk-away lock on. With no
# terminal to ask on, or a choice canceled, nothing is saved: the times
# stay as they are, the shipped ones on a first setup.
obscured_value() {
  case $1 in
    "Never (locks only when the chair empties)") echo never ;;
    "4 hours") echo 240 ;;
    "2 hours") echo 120 ;;
    "1 hour") echo 60 ;;
    "30 minutes") echo 30 ;;
    "10 minutes") echo 10 ;;
    "5 minutes") echo 5 ;;
    "2 minutes") echo 2 ;;
    "1 minute") echo 1 ;;
    *) return 1 ;;
  esac
}

ask_obscured_face_lock() {
  local kept="Obscured face lock time left as it was (as shipped: never in default mode, 2 minutes in secure mode). Change it under Setup > Security > Face > Walk-Away Lock."
  local default_choice secure_choice default_value secure_value
  if [[ -t 0 ]]; then
    echo -e "\nWith the walk-away lock on, a face that is partly covered or turned away (a hand on the chin, a look down) keeps the session open while the same shape stays in the chair. How long, in each mode?"
    if default_choice=$(gum choose --header "Obscured face lock time, default mode" --selected "Never (locks only when the chair empties)" \
        "Never (locks only when the chair empties)" "4 hours" "2 hours" "1 hour" "30 minutes" "10 minutes" "5 minutes" "2 minutes" "1 minute") \
      && default_value=$(obscured_value "$default_choice") \
      && secure_choice=$(gum choose --header "Obscured face lock time, secure mode" --selected "2 minutes" \
        "10 minutes" "5 minutes" "2 minutes" "1 minute") \
      && secure_value=$(obscured_value "$secure_choice"); then
      if sudo faceauth presence obscured-lock --default "$default_value" --secure "$secure_value"; then
        echo "Obscured face lock time saved: $default_choice in default mode, $secure_choice in secure mode."
      else
        echo -e "\e[31mThe obscured face lock time could not be saved; set it under Setup > Security > Face > Walk-Away Lock.\e[0m"
      fi
    else
      echo "$kept"
    fi
  else
    echo "$kept"
  fi
}

# The closing note: where the walk-away controls this setup put in place
# live.
closing_note() {
  echo
  echo "Walk-away lock: enable it, and change its away times and obscured face lock times, under Setup > Security > Face > Walk-Away Lock (Enable, Away Time, Obscured Face)."
  echo "While it is on, its icon sits in the top bar: a left click switches between default and secure mode, a right click lists the modes, and Super + Ctrl + Shift + L switches them from the keyboard."
}


# Face authentication takes over the key lines: sudo's and polkit's FIDO2
# line becomes the face daemon's key-fallback line, with exactly its words,
# and no pam_u2f line stays above or beside the face line. A key line setup
# cannot carry over exactly (a word it does not mirror, another key file or
# control, a second key line) stops setup here, before anything is
# installed or changed, with status 2 (install/helpers/pam-stack.sh). Run
# again right before the stacks are written, since enrollment takes a while.
check_key_lines() {
  local file problems
  for file in /etc/pam.d/sudo /etc/pam.d/polkit-1; do
    [[ -f $file ]] || continue
    if problems=$(pam_stack_key_problem "$file"); then
      echo -e "\e[31m${file##*/} has a FIDO2 line face authentication cannot take over:\e[0m" >&2
      printf '  %s\n' "$problems" >&2
      echo "Edit it in $file to Omarchy's own form (auth sufficient pam_u2f.so cue authfile=/etc/fido2/fido2, with only pinverification= and userverification= besides) and keep a single key line, or run Remove > Security > Fido2 first; then run this setup again." >&2
      exit 2
    fi
  done
}

# The IR capture node faceauth reads its frames from, locked to root (Mike's
# ruling): faceauth finds the node with its own camera detection and prints
# the rule only when that node carries infrared alone, pinned by attributes
# that do not move between boots; otherwise it says why the node is left
# open, and so does 'faceauth doctor'. The rule sorts between 70-uaccess and
# 73-seat-late, as the packaged sensor rule does, and is published whole
# from a root stage. omarchy-remove-security-face deletes it.
ir_rule_file=/etc/udev/rules.d/72-faceauth-ir-node.rules
lock_ir_capture_node() {
  local rule stage
  if ! rule=$(sudo faceauth cam ir-rule) || [[ -z $rule ]]; then
    echo "The infrared capture node stays open to your account; 'sudo faceauth doctor' says why."
    return 0
  fi
  if stage=$(sudo mktemp "${ir_rule_file%/*}/.${ir_rule_file##*/}.omarchy.XXXXXX") &&
    printf '# Written by omarchy-setup-security-face: faceauth reads its infrared frames\n# from this node, so only root may. omarchy-remove-security-face deletes it.\n%s\n' "$rule" |
    sudo install -m 644 -o root -g root -T /dev/stdin "$stage" &&
    sudo mv -Tf -- "$stage" "$ir_rule_file" &&
    sudo udevadm control --reload &&
    sudo udevadm trigger --action=change --subsystem-match=video4linux; then
    echo "The infrared capture node is now root's alone."
  else
    [[ -z ${stage:-} ]] || sudo rm -f -- "$stage"
    echo "The infrared capture node could not be locked; 'sudo faceauth doctor' says more." >&2
  fi
}

setup_face() {
  echo -e "\e[32mSetting up face authentication.\n\e[0m"

  check_key_lines

  if ! omarchy-hw-ir-camera; then
    echo -e "\e[31mNo supported infrared camera detected.\e[0m"
    echo "Face authentication drives an Intel IPU3 IR sensor (ov7251) whose illuminator the kernel exposes as a control."
    echo "USB (UVC) IR modules, the kind most Windows Hello laptops use, are not supported yet: their emitter cannot be switched, so the liveness check cannot run."
    echo "A color webcam is deliberately not enough: it cannot see in the dark and is easy to fool with a photo."
    exit 1
  fi

  echo "Infrared camera:"
  omarchy-hw-ir-camera-list | sed 's/^/  /'
  echo

  # The daemon package is a few MB; the models are 260 MB in a package of their
  # own. The daemon comes first because the check below needs it, and the
  # models only once this machine has passed that check.
  if omarchy-pkg-missing omarchy-faceauth; then
    echo "Installing face authentication..."
    omarchy-pkg-add omarchy-faceauth
  fi

  # The daemon refuses every attempt on a camera it cannot open or whose
  # illuminator it cannot switch (the stock ov7251 driver has no strobe
  # control), so the check comes before the models and enrollment, not after
  # an enrollment that can never verify. Doctor reaches the strobe check only as
  # root: as the user, the sensor's node is root-only once the udev rule holds.
  local stopped="The face models were not downloaded. 'omarchy remove security face' takes the face authentication package off again."
  doctor=$(sudo faceauth doctor --json) || true
  camera_row() { jq -r --arg id "$1" '.[] | select(.id == $id) | "\(.status) \(.detail)"' <<<"$doctor" 2>/dev/null; }
  ir_row=$(camera_row camera.ir)
  illuminator_row=$(camera_row camera.illuminator)
  if [[ $ir_row != pass* ]]; then
    echo -e "\e[31mThe face authentication service cannot open the infrared camera.\e[0m"
    echo "  camera.ir: ${ir_row:-no answer from faceauth doctor}"
    echo "Run 'sudo faceauth doctor' for the full picture."
    echo "$stopped"
    exit 1
  fi
  if [[ $illuminator_row != pass* ]]; then
    echo -e "\e[31mThis kernel cannot drive the infrared illuminator, so face authentication would refuse every attempt.\e[0m"
    echo "  camera.illuminator: ${illuminator_row:-no answer from faceauth doctor}"
    echo "The ov7251 driver needs the strobe-control patch, which the stock Omarchy kernel does not carry yet."
    echo "$stopped"
    exit 1
  fi

  # pacman owns and verifies the models, and removal takes them away; nothing
  # is downloaded by this script itself.
  if omarchy-pkg-missing omarchy-faceauth-models; then
    echo "Installing the face models (about 260 MB)..."
    omarchy-pkg-add omarchy-faceauth-models
  fi

  echo "Starting the face authentication service..."
  sudo systemctl enable --now faceauth.service

  # Enroll before touching PAM, and wire PAM only after a verification succeeds:
  # a stack pointed at a module with nothing to match would be wrong twice.
  echo -e "\e[32m\nLet's enroll your face. A window opens and walks you through it: sit as you normally do, then keep the dot on the target as it moves, so the match holds as you actually sit, not only square to the camera.\e[0m"
  echo "Your templates are numbers derived from your face, never images, stored root-only."
  echo -e "On a machine with a TPM they are sealed to it; without one they are plaintext, and 'faceauth doctor' says which.\n"

  # Enrollment changes who can unlock the machine, so the daemon takes it only
  # from root: sudo here is the password (or an existing face) standing behind it.
  if sudo faceauth enroll --user "$target_user" --guided; then
    echo -e "\nNow let's verify it works.\n"
    if faceauth auth --user "$target_user" | grep -q '^{"result":"match"'; then
      # The nod and the shake were recorded in the same walk-through, after
      # the looks, along with the ordinary movements they must stand clear
      # of. Setup > Security > Face > Tune Gestures runs those rounds again
      # on their own.
      check_key_lines
      setup_pam_config
      setup_lock_face_pam
      lock_ir_capture_node
      ask_obscured_face_lock
      # The walk-away widget joins the bar only on a machine that has face
      # authentication, so nothing polls for a daemon elsewhere. Best-effort,
      # like the plugin migrations: a shell that cannot be asked right now
      # does not fail setup, and the widget can be put on the bar later.
      omarchy-bar put omarchy.faceauth.presence --before omarchy.power 2>/dev/null || true
      echo -e "\e[32m\nFace authentication is set up.\e[0m"
      echo "Lock screen: look at the camera. sudo and polkit: nod twice at the window, or type your password there."
      echo "A head shake refuses: sudo then asks for your password in the terminal, and polkit cancels the request."
      echo "Run 'faceauth doctor' any time to see the state of every part."
      closing_note
    else
      echo -e "\e[31m\nVerification failed. Enrollment is kept; try 'faceauth auth' facing the camera, then run this again.\e[0m"
      exit 1
    fi
  else
    echo -e "\e[31m\nEnrollment failed. Please try again.\e[0m"
    exit 1
  fi
}

# Another look (glasses, a beard, lamp light) goes into the identity setup
# enrolled, under a label, and nothing else of setup runs: no PAM file is
# written. The menu's Add Look row runs it. The package is what makes face
# authentication set up; a stopped service is said as such, not as "not set
# up".
add_look() {
  local label=$1
  if omarchy-pkg-missing omarchy-faceauth; then
    echo -e "\e[31mFace authentication is not set up yet.\e[0m Run: omarchy setup security face"
    exit 1
  fi
  if ! systemctl is-active --quiet faceauth.service; then
    echo -e "\e[31mThe face authentication service is not running.\e[0m Start it with: sudo systemctl start faceauth.service"
    exit 1
  fi

  if [[ -z $label ]]; then
    label=$(gum input --prompt "Label for this look> " --placeholder "glasses, beard or lamp") || exit 1
  fi
  label=${label//[^A-Za-z0-9_-]/}
  # A leading dash would reach faceauth as an option (--label -h).
  while [[ $label == -* ]]; do
    label=${label#-}
  done
  [[ -n $label ]] || label=extra

  echo -e "\e[32m\nEnrolling another look ('$label'). A window opens: keep the dot on the target as it moves.\e[0m"
  echo "Templates are merged into your existing identity, matched by best score."
  echo

  if sudo faceauth enroll --user "$target_user" --label "$label" --guided --start distance; then
    echo -e "\e[32m\nAdded. Try it: 'faceauth auth' facing the camera in this look.\e[0m"
  else
    echo -e "\e[31m\nEnrollment failed. Please try again.\e[0m"
    exit 1
  fi
}

# The menu's Tune Gestures, Walk-Away Lock, Away Time and Obscured Face rows
# come through here instead of running sudo faceauth themselves: privileged
# work goes through an omarchy command, as omarchy-sudo-passwordless does, so
# the root guard above covers them and the menu file names no sudo. Each
# leaves the rest of setup alone. Enable and Disable run `presence on` and
# `off`, which restart the service and so also put the mode chosen from the
# bar or Super+Ctrl+Shift+L back to the one in the config; `on` keeps the saved away
# times.
#
# The away time is how long the chair stays empty before the session locks,
# one per walk-away mode; only default mode may be never. The obscured face
# lock time is how long a face that is partly covered or turned away (a hand
# on the chin, a look down) keeps the session open while the same shape stays
# in the chair, one per mode. The time flags take only the values the menu
# offers and go through `presence away-time` or `presence obscured-lock`,
# which save that one time and leave the walk-away lock on or off as it was.
case ${1:-} in
  "") setup_face ;;
  --add)
    (( $# <= 2 )) || usage
    add_look "${2:-}"
    ;;
  --gestures)
    (( $# == 1 )) || usage
    sudo faceauth calibrate --user "$target_user" --guided
    ;;
  --walk-away)
    (( $# == 2 )) || usage
    case $2 in
      on|off) sudo faceauth presence "$2" --user "$target_user" ;;
      *) usage ;;
    esac
    ;;
  --away-time)
    (( $# == 2 )) || usage
    case $2 in
      never|20|30|60) sudo faceauth presence away-time --default "$2" ;;
      *) usage ;;
    esac
    ;;
  --secure-away-time)
    (( $# == 2 )) || usage
    case $2 in
      20|30|60) sudo faceauth presence away-time --secure "$2" ;;
      *) usage ;;
    esac
    ;;
  --obscured-face-lock)
    (( $# == 2 )) || usage
    case $2 in
      never|240|120|60|30|10|5|2|1) sudo faceauth presence obscured-lock --default "$2" ;;
      *) usage ;;
    esac
    ;;
  --secure-obscured-face-lock)
    (( $# == 2 )) || usage
    case $2 in
      10|5|2|1) sudo faceauth presence obscured-lock --secure "$2" ;;
      *) usage ;;
    esac
    ;;
  *) usage ;;
esac
