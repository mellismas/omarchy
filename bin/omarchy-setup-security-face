#!/bin/bash

# omarchy:summary=Set up face authentication for the lock screen, sudo, and polkit
# omarchy:args=[--gestures | --walk-away <off|20|30|60> | --obscured-face-lock <never|240|120|60|30|10|5|2|1> | --secure-obscured-face-lock <10|5|2|1>]
# omarchy:requires-sudo=true

set -e

# These enrol the invoking user's face. Under sudo, $USER is root, which would
# enrol root and leave the real user's templates behind on removal.
if (( EUID == 0 )); then
  echo "Run omarchy-setup-security-face as your user, not under sudo (it asks for sudo where needed)." >&2
  exit 1
fi
target_user=$USER

usage() {
  echo "Usage: omarchy setup security face [--gestures | --walk-away off|20|30|60 | --obscured-face-lock never|240|120|60|30|10|5|2|1 | --secure-obscured-face-lock 10|5|2|1]" >&2
  exit 1
}


# The polkit override setup creates is remembered by a copy of exactly what
# it wrote, kept outside /etc/pam.d because a stray file inside the PAM
# directory is a service of its own. Removal deletes the override only while
# it still matches the copy. The directory is root-only, so the marker is
# looked up through sudo.
marker_dir=/var/backups/faceauth
created_marker=$marker_dir/polkit-1.created-by-faceauth
# sudo: everything the module returns but a match is ignore, and the stack
# falls to the terminal password as usual (a shake at the window means "not
# by face"). polkit: a refusal at the window is PAM_AUTH_ERR and ends the
# stack, and the agent cancels the request on it; otherwise polkit would
# start the helper again and ask forever.
face_line='auth      sufficient pam_faceauth.so socket=/run/faceauth/sock consent'
polkit_face_line='auth      [success=done auth_err=die default=ignore] pam_faceauth.so socket=/run/faceauth/sock consent'

# Elevation is a deliberate act: the line carries `consent`, so the daemon
# opens a window naming the request and approves it only on two nods (or the
# password typed there). Sitting in front of the machine never elevates
# anything by itself. Every failure inside the module is PAM_IGNORE, so the
# password path stays the floor. What the user's own no does depends on the
# stack: on sudo, `sufficient` turns it into ignore too and the terminal
# prompt follows; on polkit, auth_err=die ends the stack so the agent can
# cancel the request.
#
# The line goes above the password but after any fingerprint or FIDO2 line,
# whichever was set up first: a touch or a tap then still answers first,
# and the face window, which has no deadline, does not sit above a reader
# the user meant to use. Fingerprint and FIDO2 setup insert at line 1, so
# they keep that place when they come later.
#
# A face line that is not exactly ours (a hand-edited stack, or one missing
# `consent`) would approve on a plain look with no window at all, so it is
# replaced rather than kept.
write_face_line() {
  local file="$1" line="$2" after
  if grep -qxF "$line" "$file"; then
    echo "${file##*/} is already configured for face authentication."
    return 0
  fi
  if grep -qE '^[^#]*pam_faceauth\.so' "$file"; then
    echo "Replacing a face line in ${file##*/} that setup did not write..."
    sudo sed -i '/pam_faceauth\.so/d' "$file"
  else
    echo "Configuring ${file##*/} for face authentication..."
  fi
  after=$(grep -nE '^[^#]*(pam_fprintd|pam_u2f)\.so' "$file" | tail -1 | cut -d: -f1)
  if [[ -n $after ]]; then
    sudo sed -i "${after}a $line" "$file"
  else
    sudo sed -i "1i $line" "$file"
  fi
}

setup_pam_config() {
  write_face_line /etc/pam.d/sudo "$face_line"

  if [[ -f /etc/pam.d/polkit-1 ]]; then
    write_face_line /etc/pam.d/polkit-1 "$polkit_face_line"
  else
    # No file in /etc/pam.d means polkit runs the vendor stack; an override
    # there must carry the whole stack, not just our line. The marker keeps a
    # copy of exactly what was written: removal deletes the file, returning
    # polkit to the vendor stack, only while it still matches that copy. A
    # fingerprint or FIDO2 line added later makes the file someone else's too,
    # and then removal strips our line and leaves the rest in place.
    echo "Creating polkit configuration with face authentication..."
    sudo install -dm700 "$marker_dir"
    # omarchy:heredoc-expands paths=polkit_face_line -- $polkit_face_line is the constant PAM
    # line set at the top of this script, never user input; nothing else expands.
    sudo tee /etc/pam.d/polkit-1 >/dev/null <<EOF
#%PAM-1.0
$polkit_face_line
auth       include      system-auth
account    include      system-auth
password   include      system-auth
session    include      system-auth
EOF
    sudo cp -p /etc/pam.d/polkit-1 "$created_marker"
  fi
}

# The lock screen's face stack is its own PAM service beside the password and
# fingerprint ones, so it takes no prompt: looking at the machine is the act.
# The password is a separate service on its own lane, so this one must be
# closed: an ignore-only stack fails closed on Linux-PAM 1.7.2
# (PAM_PERM_DENIED), but that is library behaviour, not a promise, and
# pam_deny makes it explicit.
setup_lock_face_pam() {
  echo "Configuring lock screen for face authentication..."
  sudo tee /etc/pam.d/omarchy-lock-face >/dev/null <<'EOF'
#%PAM-1.0
auth       sufficient                  pam_faceauth.so socket=/run/faceauth/sock timeout=8
auth       required                    pam_deny.so
account    include                     system-local-login
EOF
}

# After a successful enrolment setup asks for both obscured face lock times,
# with the shipped ones selected, and saves them with `presence
# obscured-lock`, which never switches the walk-away lock on. With no
# terminal to ask on, or a choice cancelled, nothing is saved: the times
# stay as they are, the shipped ones on a first setup.
obscured_value() {
  case $1 in
    "Never (locks only when the chair empties)") echo never ;;
    "4 hours") echo 240 ;;
    "2 hours") echo 120 ;;
    "1 hour") echo 60 ;;
    "30 minutes") echo 30 ;;
    "10 minutes") echo 10 ;;
    "5 minutes") echo 5 ;;
    "2 minutes") echo 2 ;;
    "1 minute") echo 1 ;;
    *) return 1 ;;
  esac
}

ask_obscured_face_lock() {
  local kept="Obscured face lock time left as it was (as shipped: never in default mode, 2 minutes in secure mode). Change it under Setup > Security > Face > Walk-Away Lock."
  local default_choice secure_choice default_value secure_value
  if [[ -t 0 ]]; then
    echo -e "\nWith the walk-away lock on, a face that is partly covered or turned away (a hand on the chin, a look down) keeps the session open while the same shape stays in the chair. How long, in each mode?"
    if default_choice=$(gum choose --header "Obscured face lock time, default mode" --selected "Never (locks only when the chair empties)" \
        "Never (locks only when the chair empties)" "4 hours" "2 hours" "1 hour" "30 minutes" "10 minutes" "5 minutes" "2 minutes" "1 minute") \
      && default_value=$(obscured_value "$default_choice") \
      && secure_choice=$(gum choose --header "Obscured face lock time, secure mode" --selected "2 minutes" \
        "10 minutes" "5 minutes" "2 minutes" "1 minute") \
      && secure_value=$(obscured_value "$secure_choice"); then
      if sudo faceauth presence obscured-lock --default "$default_value" --secure "$secure_value"; then
        echo "Obscured face lock time saved: $default_choice in default mode, $secure_choice in secure mode."
      else
        echo -e "\e[31mThe obscured face lock time could not be saved; set it under Setup > Security > Face > Walk-Away Lock.\e[0m"
      fi
    else
      echo "$kept"
    fi
  else
    echo "$kept"
  fi
}


setup_face() {
  echo -e "\e[32mSetting up face authentication.\n\e[0m"

  if ! omarchy-hw-ir-camera; then
    echo -e "\e[31mNo supported infrared camera detected.\e[0m"
    echo "Face authentication drives an Intel IPU3 IR sensor (ov7251) whose illuminator the kernel exposes as a control."
    echo "USB (UVC) IR modules, the kind most Windows Hello laptops use, are not supported yet: their emitter cannot be switched, so the liveness check cannot run."
    echo "A colour webcam is deliberately not enough: it cannot see in the dark and is easy to fool with a photo."
    exit 1
  fi

  echo "Infrared camera:"
  omarchy-hw-ir-camera-list | sed 's/^/  /'
  echo

  # The models are their own package, so pacman owns and verifies the 260 MB
  # and removal takes it away; nothing is downloaded by this script.
  if omarchy-pkg-missing omarchy-faceauth omarchy-faceauth-models; then
    echo "Installing face authentication..."
    omarchy-pkg-add omarchy-faceauth omarchy-faceauth-models
  fi

  # The daemon refuses every attempt on a camera it cannot open or whose
  # illuminator it cannot switch (the stock ov7251 driver has no strobe
  # control), so the check comes before enrolment, not after an enrolment that
  # can never verify. Doctor reaches the strobe check only as
  # root: as the user, the sensor's node is root-only once the udev rule holds.
  doctor=$(sudo faceauth doctor --json) || true
  camera_row() { jq -r --arg id "$1" '.[] | select(.id == $id) | "\(.status) \(.detail)"' <<<"$doctor" 2>/dev/null; }
  ir_row=$(camera_row camera.ir)
  illuminator_row=$(camera_row camera.illuminator)
  if [[ $ir_row != pass* ]]; then
    echo -e "\e[31mThe face authentication service cannot open the infrared camera.\e[0m"
    echo "  camera.ir: ${ir_row:-no answer from faceauth doctor}"
    echo "Run 'sudo faceauth doctor' for the full picture."
    exit 1
  fi
  if [[ $illuminator_row != pass* ]]; then
    echo -e "\e[31mThis kernel cannot drive the infrared illuminator, so face authentication would refuse every attempt.\e[0m"
    echo "  camera.illuminator: ${illuminator_row:-no answer from faceauth doctor}"
    echo "The ov7251 driver needs the strobe-control patch, which the stock Omarchy kernel does not carry yet."
    exit 1
  fi

  echo "Starting the face authentication service..."
  sudo systemctl enable --now faceauth.service

  # Enrol before touching PAM, and wire PAM only after a verification succeeds:
  # a stack pointed at a module with nothing to match would be wrong twice.
  echo -e "\e[32m\nLet's enrol your face. A window opens and walks you through it: sit as you normally do, then keep the dot on the target as it moves, so the match holds as you actually sit, not only square to the camera.\e[0m"
  echo "Your templates are numbers derived from your face, never images, stored root-only."
  echo -e "On a machine with a TPM they are sealed to it; without one they are plaintext, and 'faceauth doctor' says which.\n"

  # Enrolment changes who can unlock the machine, so the daemon takes it only
  # from root: sudo here is the password (or an existing face) standing behind it.
  if sudo faceauth enroll --user "$target_user" --guided; then
    echo -e "\nNow let's verify it works.\n"
    if faceauth auth --user "$target_user" | grep -q '^{"result":"match"'; then
      # The nod and the shake were recorded in the same walk-through, after
      # the looks, along with the ordinary movements they must stand clear
      # of. Setup > Security > Face > Tune Gestures runs those rounds again
      # on their own.
      setup_pam_config
      setup_lock_face_pam
      ask_obscured_face_lock
      # The walk-away widget joins the bar only on a machine that has face
      # authentication, so nothing polls for a daemon elsewhere. Best-effort,
      # like the plugin migrations: a shell that cannot be asked right now
      # does not fail setup, and the widget can be put on the bar later.
      omarchy-bar put omarchy.faceauth.presence --before omarchy.power 2>/dev/null || true
      echo -e "\e[32m\nFace authentication is set up.\e[0m"
      echo "Lock screen: look at the camera. sudo and polkit: nod twice at the window, shake to refuse, or type your password there."
      echo "Run 'faceauth doctor' any time to see the state of every part."
    else
      echo -e "\e[31m\nVerification failed. Enrolment is kept; try 'faceauth auth' facing the camera, then run this again.\e[0m"
      exit 1
    fi
  else
    echo -e "\e[31m\nEnrolment failed. Please try again.\e[0m"
    exit 1
  fi
}

# The menu's Tune Gestures, Walk-Away and obscured face rows come through here
# instead of running sudo faceauth themselves: privileged work goes through
# an omarchy command, as omarchy-sudo-passwordless does, so the root guard
# above covers them and the menu file names no sudo. Each leaves the rest of
# setup alone. A walk-away change restarts the service, which also puts the
# mode chosen from the bar or Super+Ctrl+Shift+L back to the one in the config.
#
# The obscured face lock time is how long a face that is partly covered or
# turned away (a hand on the chin, a look down) keeps the session open while
# the same shape stays in the chair, one time per walk-away mode. The two
# flags take only the values the menu offers and go through `presence
# obscured-lock`, which saves that one time and leaves the walk-away lock on
# or off as it was.
case ${1:-} in
  "") setup_face ;;
  --gestures)
    (( $# == 1 )) || usage
    sudo faceauth calibrate --user "$target_user" --guided
    ;;
  --walk-away)
    (( $# == 2 )) || usage
    case $2 in
      off) sudo faceauth presence off --user "$target_user" ;;
      20|30|60) sudo faceauth presence on --user "$target_user" --away-seconds "$2" ;;
      *) usage ;;
    esac
    ;;
  --obscured-face-lock)
    (( $# == 2 )) || usage
    case $2 in
      never|240|120|60|30|10|5|2|1) sudo faceauth presence obscured-lock --default "$2" ;;
      *) usage ;;
    esac
    ;;
  --secure-obscured-face-lock)
    (( $# == 2 )) || usage
    case $2 in
      10|5|2|1) sudo faceauth presence obscured-lock --secure "$2" ;;
      *) usage ;;
    esac
    ;;
  *) usage ;;
esac
