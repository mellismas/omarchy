#!/bin/bash

# omarchy:summary=Set up FIDO2 authentication for sudo and polkit
# omarchy:requires-sudo=true

set -e
set -o pipefail

source "$OMARCHY_PATH/install/helpers/pam-stack.sh"


check_fido2_hardware() {
  tokens=$(fido2-token -L 2>/dev/null)
  if [[ -z $tokens ]]; then
    echo -e "\e[31m\nNo FIDO2 device detected. Please plug it in (you may need to unlock it as well).\e[0m"
    return 1
  fi
  return 0
}

# With face set up, the key line is the face daemon's own key-fallback
# line, right below the face line: every use of the key then goes through
# the daemon, which asks the key on the card, on this line and on the lock
# screen, one at a time and never for a request nobody can see. Without
# face it is the pam_u2f line, first, as Omarchy has always written it. A
# pam_u2f line setup did not write stays where it is, and the daemon then
# offers the key nowhere (install/helpers/pam-stack.sh; faceauth doctor
# says why).
write_u2f_line() {
  local file=$1 name=$2
  pam_stack_needed "$file" fido2 "" || return 0
  if grep -qE '^[^#]*pam_faceauth\.so.*[[:space:]]consent([[:space:]]|$)' "$file"; then
    echo "Configuring $name to take the key through face authentication..."
  elif grep -qE '^[^#]*pam_u2f\.so' "$file"; then
    echo "Moving the FIDO2 line in $name into place..."
  else
    echo "Configuring $name for FIDO2 authentication..."
  fi
  if ! pam_stack_place "$file" fido2 ""; then
    echo -e "\e[31mThe $name configuration could not be changed as intended and was left as it was.\e[0m"
    return 1
  fi
}

# The lock screen takes the key through the face daemon, never through a
# pam_u2f stack of its own: its key lane, omarchy-lock-fido2, is the
# daemon's key-unlock line, written only when face authentication is set up
# and the key goes through the daemon (install/helpers/pam-stack.sh). The
# daemon asks the key for what sudo's key line asks, user verification
# included, only while the session is locked, and keeps the face window and
# the stacks' key lines off the key meanwhile, so a touch while locked can
# only unlock. A line that asks for the key's PIN gets no lane: the lock
# screen has no PIN field.
setup_lock_pam() {
  local extras status=0
  if [[ ! -f /etc/pam.d/omarchy-lock-face ]]; then
    echo "The lock screen keeps to its other ways in: it takes the key through face authentication, which is not set up."
  fi
  pam_stack_key_lane /etc/pam.d/omarchy-lock-fido2 /etc/pam.d/omarchy-lock-face /etc/pam.d/sudo /etc/pam.d/polkit-1 || status=$?
  if (( status == 2 )); then
    echo -e "\e[31mThe lock screen's key lane could not be changed as intended.\e[0m"
    return 1
  fi
  if [[ ! -f /etc/pam.d/omarchy-lock-fido2 ]]; then
    if [[ -f /etc/pam.d/omarchy-lock-face ]]; then
      echo "The lock screen keeps to its other ways in: a FIDO2 line setup did not write reads the key outside face authentication (faceauth doctor says which)."
    fi
    return 0
  fi
  (( status == 0 )) && echo "Configuring the lock screen to take the key through face authentication..."
  # The daemon decides at each lock, from sudo's line as it stands then;
  # say now what it will decide from the line as it stands today.
  if ! extras=$(pam_stack_u2f_extras /etc/pam.d/sudo); then
    echo "The lock screen will not offer the key while sudo has $extras."
  elif [[ $extras == *pinverification=1* ]]; then
    echo "The lock screen will not offer the key while your FIDO2 line asks for its PIN: the lock screen has no PIN field."
  fi
  return 0
}

# Created whole when polkit has no file of its own (it runs the vendor
# stack then), under the PAM edit lock, unless one appeared meanwhile.
fido2_polkit_stack='auth      sufficient pam_u2f.so cue authfile=/etc/fido2/fido2
auth      include system-auth

account   include system-auth
password  include system-auth
session   include system-auth'

# With face set up, the key line is the face daemon's, and a key line it
# cannot carry over exactly stops this setup before anything changes, as
# it stops face setup (install/helpers/pam-stack.sh). Without face, stock
# Omarchy's own rules stand.
check_key_lines() {
  local file problems
  for file in /etc/pam.d/sudo /etc/pam.d/polkit-1; do
    [[ -f $file ]] || continue
    grep -qE '^[^#]*pam_faceauth\.so.*[[:space:]]consent([[:space:]]|$)' "$file" || continue
    if problems=$(pam_stack_key_problem "$file"); then
      echo -e "\e[31m${file##*/} has a FIDO2 line face authentication cannot take over:\e[0m" >&2
      printf '  %s\n' "$problems" >&2
      echo "Edit it in $file to Omarchy's own form (auth sufficient pam_u2f.so cue authfile=/etc/fido2/fido2, with only pinverification= and userverification= besides) and keep a single key line, or run Remove > Security > Fido2 first; then run this setup again." >&2
      exit 2
    fi
  done
}

setup_pam_config() {
  check_key_lines

  # Configure sudo
  write_u2f_line /etc/pam.d/sudo sudo

  # Configure polkit
  if [[ -f /etc/pam.d/polkit-1 ]]; then
    write_u2f_line /etc/pam.d/polkit-1 polkit
  else
    echo "Creating polkit configuration with FIDO2 authentication..."
    local status=0
    pam_stack_create /etc/pam.d/polkit-1 "$fido2_polkit_stack" fido2 "" || status=$?
    if (( status == 2 )); then
      echo -e "\e[31mThe polkit configuration could not be created as intended.\e[0m"
      return 1
    fi
  fi

  # Configure the lock screen
  setup_lock_pam
}

echo -e "\e[32mSetting up FIDO2 device for authentication.\n\e[0m"

# Install required packages
echo "Installing required packages..."
omarchy-pkg-add libfido2 pam-u2f

if ! check_fido2_hardware; then
  exit 1
fi

# Create the pamu2fcfg file
authdir=/etc/fido2
authfile=/etc/fido2/fido2

# install -d follows a symlink here and applies the mode and ownership to
# whatever it points at, so the credential would be staged and published inside
# the link target and that directory reopened to root:root 755. This is the
# threat omarchy-remove-security-fido2 already names on its side.
if [[ -L $authdir || ( -e $authdir && ! -d $authdir ) ]]; then
  echo -e "\e[31m\n$authdir is not a FIDO2 configuration directory.\e[0m"
  echo "Run omarchy-remove-security-fido2 first, then set FIDO2 up again."
  exit 1
fi

# -f follows symlinks, so the already-registered check below reads a symlinked
# authfile as a registration and leaves it in place, and is false for a
# directory, so it tries to register over one. Only a regular file is a valid
# pam_u2f authfile.
if [[ -L $authfile || ( -e $authfile && ! -f $authfile ) ]]; then
  echo -e "\e[31m\n$authfile is not a FIDO2 registration file.\e[0m"
  echo "Run omarchy-remove-security-fido2 first, then set FIDO2 up again."
  exit 1
fi

if [[ ! -f $authfile ]]; then
  sudo install -d -m 755 -o root -g root "$authdir"
  echo -e "\e[32m\nLet's setup your device by confirming on the device now.\e[0m"
  echo -e "Touch your FIDO2 key when it lights up...\n"

  # A unique sibling created by root cannot be replaced by another process
  # running as this user. Stream pamu2fcfg into it instead of asking root to
  # reopen a caller-owned path: an observed temporary name could otherwise be
  # replaced with a symlink before the privileged copy. The final rename is
  # atomic, and -T refuses a directory at the destination. Mode 644 keeps the
  # root-owned global authfile readable when pam_u2f uses openasuser; only root
  # can still rewrite it.
  stage=""

  # mktemp's output is an operand for four privileged commands below, one of
  # them an rm. Take only the name this script asked for rather than whatever
  # came back on stdout.
  safe_stage_path() {
    local candidate=$1
    local prefix="$authfile.new."
    local suffix

    [[ $candidate == "$prefix"* ]] || return 1
    suffix=${candidate#"$prefix"}
    [[ $suffix =~ ^[[:alnum:]]{6}$ ]]
  }

  cleanup_stage() {
    local status=$?

    if safe_stage_path "$stage"; then
      sudo rm -f -- "$stage" || true
    fi

    return "$status"
  }

  trap cleanup_stage EXIT
  stage=$(sudo mktemp "$authfile.new.XXXXXX")

  if ! safe_stage_path "$stage" || [[ ! -f $stage || -L $stage ]]; then
    echo -e "\e[31m\nCould not create a safe staging file beside $authfile.\e[0m"
    exit 1
  fi

  if pamu2fcfg | sudo tee "$stage" >/dev/null && [[ -s $stage ]]; then
    sudo chmod 644 "$stage"
    sudo mv -Tf "$stage" "$authfile"
    stage=""
    trap - EXIT
    echo -e "\e[32mFIDO2 device registered successfully!\e[0m"
  else
    echo -e "\e[31m\nFIDO2 registration failed. Please try again.\e[0m"
    exit 1
  fi
else
  echo "FIDO2 device already registered."
fi

# Configure PAM
setup_pam_config

# Test with sudo, for real: the setup's own sudo calls above leave a
# timestamp that would pass this test without asking anything.
echo -e "\nTesting FIDO2 authentication with sudo..."
echo -e "Touch your FIDO2 key when prompted.\n"

sudo -k
if sudo echo "FIDO2 authentication test successful"; then
  echo -e "\e[32m\nPerfect! FIDO2 authentication is now configured.\e[0m"
  echo "You can use your FIDO2 key for sudo and polkit authentication."
else
  echo -e "\e[31m\nVerification failed. You may want to check your configuration.\e[0m"
fi
